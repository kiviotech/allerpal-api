{
  "kind": "collectionType",
  "collectionName": "profile_allergies",
  "info": {
    "singularName": "profile-allergy",
    "pluralName": "profile-allergies",
    "displayName": "Profile Allergy",
    "description": "Allergies associated with a specific profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "profile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "inversedBy": "profile_allergies"
    },
    "severity": {
      "type": "enumeration",
      "enum": [
        "mild",
        "moderate",
        "severe"
      ],
      "default": "mild"
    },
    "allergies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::allergy.allergy",
      "inversedBy": "profile_allergies"
    },
    "excludeMayContain": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "text"
    }
  }
}
