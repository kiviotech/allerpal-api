{
  "kind": "collectionType",
  "collectionName": "allergies",
  "info": {
    "singularName": "allergy",
    "pluralName": "allergies",
    "displayName": "Allergy",
    "description": "Allergy information that can be associated with profiles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "user_allergy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-allergy.user-allergy",
      "inversedBy": "allergies",
      "deprecated": true,
      "private": false
    },
    "is_custom": {
      "type": "boolean",
      "default": false
    },
    "Allergeimage": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "profile_allergies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::profile-allergy.profile-allergy",
      "mappedBy": "allergies"
    },
    "Allergen_icon": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    },
    "menu_items": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::menu-item.menu-item",
      "mappedBy": "allergens"
    },
    "description": {
      "type": "text"
    }
  }
}
